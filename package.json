{
  "name": "mobile-hot-reload",
  "version": "1.0.1",
  "description": "This is a sample plugin for Obsidian (https://obsidian.md)",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" && prettier --write \"*.md\"",
    "release": "bash release.sh",
    "verify-release": "bash verify-release.sh"
  },
  "keywords": [],
  "license": "0BSD",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "obsidian-typings": "^6.59.0",
    "prettier": "^3.9.10",
    "prettier-plugin-sh": "^0.20.2",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "monkey-around": "^3.0.0",
    "obsidian": "^1.14.4"
  },
  "overrides": {
    "obsidian": "$obsidian"
  }
}
